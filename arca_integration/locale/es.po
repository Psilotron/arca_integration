#: arca_integration/arca/doctype/arca_access_ticket/arca_access_ticket.py:97
msgid "ARCA already issued an access ticket for this certificate and service, but this site did not keep it. Try again when it expires (up to 12 hours) or use a new certificate."
msgstr "ARCA ya emitió un ticket de acceso para este certificado y servicio, pero este sitio no lo conservó. Volvé a intentar cuando venza (hasta 12 horas) o usá un certificado nuevo."

#: arca_integration/arca/connection.py:75
msgid "ARCA already issued an access ticket for this certificate that this site did not keep."
msgstr "ARCA ya emitió un ticket de acceso para este certificado y este sitio no lo conservó."

#: arca_integration/arca/connection.py:85
#, python-brace-format
msgid "ARCA answered: {0}"
msgstr "ARCA respondió: {0}"

#: arca_integration/arca/connection.py:285
msgid "ARCA codes"
msgstr "Códigos de ARCA"

#: arca_integration/arca/emission.py:169
msgid "ARCA did not answer in time and it could not be confirmed whether it authorized the invoice. The invoice was not submitted. When you try again, this site first asks ARCA and recovers the CAE if it was issued."
msgstr "ARCA no respondió a tiempo y no se pudo confirmar si autorizó la factura. La factura no se validó. Cuando lo intentes de nuevo, primero se consulta a ARCA y, si el CAE se emitió, se recupera."

#: arca_integration/services/mtxca/messages.py:53
msgid "ARCA does not accept the customer's VAT condition for this voucher type."
msgstr "ARCA no acepta la condición de IVA del cliente para este tipo de comprobante."

#: arca_integration/arca/invoice.py:225
#, python-brace-format
msgid "ARCA does not allow A or B invoices for the VAT condition of {0}."
msgstr "ARCA no permite facturas A ni B para la condición de IVA de {0}."

#: arca_integration/arca/connection.py:69
#, python-brace-format
msgid "ARCA does not find CUIT {0} among the relations of this certificate."
msgstr "ARCA no encuentra la CUIT {0} entre las relaciones de este certificado."

#: arca_integration/arca/padron.py:55
#, python-brace-format
msgid "ARCA does not issue this taxpayer's constancia: {0}"
msgstr "ARCA no emite la constancia de este contribuyente: {0}"

#: arca_integration/arca/connection.py:53
#, python-brace-format
msgid "ARCA does not recognize this certificate for {0}."
msgstr "ARCA no reconoce este certificado para {0}."

#: arca_integration/arca/doctype/arca_company_settings/arca_company_settings.js:182
msgid "ARCA does not register this CUIT as VAT registered (Responsable Inscripto). WSMTXCA only authorizes A and B invoices, which require it."
msgstr "ARCA no registra esta CUIT como Responsable Inscripto en IVA. WSMTXCA solo autoriza facturas A y B, que lo requieren."

#: arca_integration/arca/emission.py:88
#, python-brace-format
msgid "ARCA had already authorized this invoice (CAE {0}). The CAE was recovered."
msgstr "ARCA ya había autorizado esta factura (CAE {0}). Se recuperó el CAE."

#: arca_integration/arca/connection.py:196
msgid "ARCA has no active point of sale for invoices with item detail for this CUIT."
msgstr "ARCA no tiene ningún punto de venta activo para facturas con detalle de ítems de esta CUIT."

#: arca_integration/arca/padron.py:103
#, python-brace-format
msgid "ARCA has no taxpayer with CUIT {0}."
msgstr "ARCA no tiene ningún contribuyente con la CUIT {0}."

#: arca_integration/arca/emission.py:97
#, python-brace-format
msgid "ARCA has voucher {0} for this point of sale, but this site did not issue it. Another system may be using the point of sale. Use a point of sale only for ERPNext."
msgstr "ARCA tiene el comprobante {0} en este punto de venta, pero no lo emitió este sitio. Puede que otro sistema use el mismo punto de venta. Usá un punto de venta exclusivo para ERPNext."

#: arca_integration/arca/connection.py:209
#, python-brace-format
msgid "ARCA has {0} active points of sale."
msgstr "ARCA tiene {0} puntos de venta activos."

#: arca_integration/arca/connection.py:231
msgid "ARCA is answering."
msgstr "ARCA está respondiendo."

#: arca_integration/arca/emission.py:172
msgid "ARCA is not responding. Your invoice was not submitted; try again in a few minutes."
msgstr "ARCA no está respondiendo. Tu factura no se validó; probá de nuevo en unos minutos."

